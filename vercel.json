{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/learn",
      "destination": "/foundation/",
      "permanent": false
    },
    {
      "source": "/physics",
      "destination": "/foundation/physics",
      "permanent": false
    }
  ]
}
